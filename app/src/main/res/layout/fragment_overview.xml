<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F9FE">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- CABEÇALHO SUPERIOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SyncOps"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#5C6BC0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 🛠️ SCRUM MASTER "
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#FFA000"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visão Executiva • Liderança Ágil"
                    android:textSize="12sp"
                    android:textColor="#78909C"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Olá, Ana Silva"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#37474F"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="🌙"
                        android:gravity="center"
                        android:background="#EFEBE9"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text=" Sair "
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#D32F2F"
                        android:background="#FFEBEE"
                        android:paddingHorizontal="8dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- CARD PRINCIPAL DA SPRINT -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeColor="#E8EAF6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvSprintBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚀 Sprint 03 - Motor Principal"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32"
                        android:background="#E8F5E9"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Painel de Liderança"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#5C6BC0"
                        android:background="#EDE7F6"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meta da Sprint (Objetivo)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#263238"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvSprintGoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="&quot;Finalizar motor de cronômetro, autenticação e integração com repositórios Git.&quot;"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:textColor="#546E7A"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#F3F4F6"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="12dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvDaysRemaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="#3F51B5" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DIAS RESTANTES"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="#78909C" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- PAINEL DE CONFIGURAÇÃO DO SCRUM MASTER -->
                <LinearLayout
                    android:id="@+id/layoutMasterConfig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0E0E0"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️ Configurar Sprint Ativa (Exclusivo Scrum Master)"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#3F51B5"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etSprintTitleInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Sprint 03 - Motor Principal"
                        android:textSize="13sp"
                        android:background="@android:drawable/editbox_background_normal"
                        android:padding="10dp"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <EditText
                            android:id="@+id/etSprintGoalInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:hint="Objetivo da sprint..."
                            android:textSize="13sp"
                            android:background="@android:drawable/editbox_background_normal"
                            android:padding="10dp"
                            android:layout_marginEnd="6dp" />

                        <EditText
                            android:id="@+id/etSprintDaysInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="4"
                            android:inputType="number"
                            android:textSize="13sp"
                            android:background="@android:drawable/editbox_background_normal"
                            android:padding="10dp"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSaveSprint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Salvar Sprint"
                        android:backgroundTint="#5C6BC0"
                        android:textColor="@android:color/white" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- GRID DE MÉTRICAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="#E8EAF6"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STORY POINTS"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#78909C" />
                    <TextView
                        android:id="@+id/tvStoryPointsMetric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 / 34 pts"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#263238"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="#E8EAF6"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONCLUÍDAS"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#78909C" />
                    <TextView
                        android:id="@+id/tvCompletedTasksMetric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1/1"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#263238"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="#E8EAF6"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEMPO DE FOCO"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#78909C" />
                    <TextView
                        android:id="@+id/tvFocusTimeMetric"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0h 0m"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#263238"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- PROGRESSO DA SPRINT -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E8EAF6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Progresso da Sprint (Burndown)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#263238" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6%"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#3F51B5" />
                </LinearLayout>

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="6"
                    android:max="100" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- LINHA DO TEMPO (ROADMAP) COM BOTÃO DE MINIMIZAR/MAXIMIZAR -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E8EAF6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Cabeçalho Clicável da Linha do Tempo -->
                <LinearLayout
                    android:id="@+id/headerTimelineToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🗺️ Linha do Tempo "
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#263238" />

                    <TextView
                        android:id="@+id/tvTimelineToggleArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▲"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#5C6BC0"
                        android:padding="4dp" />
                </LinearLayout>

                <!-- Conteúdo Retrátil da Linha do Tempo -->
                <LinearLayout
                    android:id="@+id/layoutTimelineContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Marcos do projeto gerenciados em tempo real."
                        android:textSize="12sp"
                        android:textColor="#78909C"
                        android:layout_marginBottom="12dp" />

                    <!-- Fase 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="✔"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:textColor="@android:color/white"
                            android:background="#2E7D32"
                            android:layout_marginEnd="8dp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fase 1: Concepção &amp; Protótipo"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#2E7D32" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Estruturação de fluxos e validação com clientes"
                                android:textSize="11sp"
                                android:textColor="#78909C" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Fase 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="🔵"
                            android:textSize="10sp"
                            android:gravity="center"
                            android:layout_marginEnd="8dp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fase 2: Desenvolvimento do MVP"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#0284C7" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Implementação do motor ágil, cronômetro e aprovações"
                                android:textSize="11sp"
                                android:textColor="#78909C" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Fase 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="⭕"
                            android:textSize="10sp"
                            android:gravity="center"
                            android:layout_marginEnd="8dp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fase 3: Testes de Qualidade &amp; Piloto"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#263238" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Homologação com equipes reais de software"
                                android:textSize="11sp"
                                android:textColor="#78909C" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Fase 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:text="⭕"
                            android:textSize="10sp"
                            android:gravity="center"
                            android:layout_marginEnd="8dp" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fase 4: Lançamento em Produção"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="#263238" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Disponibilização oficial e integração contínua"
                                android:textSize="11sp"
                                android:textColor="#78909C" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CHECKLIST RÁPIDO DO DIA COM BOTÃO DE MINIMIZAR/MAXIMIZAR -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#E8EAF6"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Cabeçalho Clicável do Checklist -->
                <LinearLayout
                    android:id="@+id/headerChecklistToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋 Checklist Rápido do Dia"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#263238" />

                    <TextView
                        android:id="@+id/tvChecklistCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/2"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:background="#E2E8F0"
                        android:layout_marginStart="8dp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvChecklistToggleArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▲"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#5C6BC0"
                        android:padding="4dp" />
                </LinearLayout>

                <!-- Conteúdo Retrátil do Checklist -->
                <LinearLayout
                    android:id="@+id/layoutChecklistContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:layout_marginTop="12dp">

                    <!-- Linha de Adição com Campo de Texto e Botão Mais Ajustados -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <EditText
                            android:id="@+id/etNewCheckItem"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:hint="Adicionar meta rápida..."
                            android:textSize="13sp"
                            android:background="@android:drawable/editbox_background_normal"
                            android:paddingHorizontal="12dp"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/btnAddCheckItem"
                            android:layout_width="56dp"
                            android:layout_height="38dp"
                            android:text="+"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:backgroundTint="#0284C7"
                            android:textColor="@android:color/white"
                            android:padding="0dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutChecklistContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>