<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F6F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center">

        <!-- Card Branco Principal (Molde Centralizado) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="440dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Título e Subtítulo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SyncOps"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#0284C7"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plataforma de Engenharia &amp; Gestão Ágil"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp" />

                <!-- Botão Google Workspace -->

                <!-- Botão Microsoft 365 -->
                <Button
                    android:id="@+id/btnGoogleLogin"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="   Entrar com Google Workspace"
                    android:textAllCaps="false"
                    android:textColor="#1E293B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:icon="@android:drawable/ic_menu_compass"
                    app:iconTint="@null"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp" />

                <Button
                    android:id="@+id/btnMicrosoftLogin"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="   Entrar com Microsoft 365"
                    android:textAllCaps="false"
                    android:textColor="#1E293B"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1dp"
                    app:icon="@android:drawable/ic_menu_gallery"
                    app:iconTint="@null"
                    android:layout_marginBottom="16dp" />

                <!-- Divisor "ou acesse com seu e-mail" -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E2E8F0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" ou acesse com seu e-mail "
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E2E8F0" />
                </LinearLayout>

                <!-- Campo E-mail Profissional -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E-mail Profissional"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="seu.nome@empresa.com"
                    android:inputType="textEmailAddress"
                    android:textSize="13sp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- Campo Senha -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Senha"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_marginBottom="6dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="••••••••"
                        android:inputType="textPassword"
                        android:textSize="13sp"
                        android:background="@android:drawable/editbox_background_normal"
                        android:padding="12dp"
                        android:paddingEnd="40dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👁️"
                        android:textSize="16sp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp" />
                </FrameLayout>

                <!-- Checkbox Lembrar & Esqueceu Senha -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <CheckBox
                        android:id="@+id/cbRemember"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lembrar meu e-mail"
                        android:textSize="12sp"
                        android:textColor="#475569" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Esqueci minha senha"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0284C7" />
                </LinearLayout>

                <!-- Botão de Entrar -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Entrar no SyncOps"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#0284C7"
                    android:textColor="@android:color/white"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="16dp" />

                <!-- Rodapé: Cadastre-se -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Não tem uma conta? "
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:id="@+id/tvRegister"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cadastre-se"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0284C7" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>